{
  "extends": [
    "../tsconfig.base.json",
    "expo/tsconfig.base.json"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@philo-mind/shared": [
        "../libs/shared/src/index.ts"
      ],
      "@philo-mind/shared/*": [
        "../libs/shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": []
}