generator client {
  provider            = "prisma-client"
  output              = "../prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum StorySessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum SenderType {
  USER
  AI
  SYSTEM
}

enum DebateStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum DebateStance {
  AGREE
  DISAGREE
  NEUTRAL
}

enum VoteValue {
  UP
  DOWN
}

enum QuestionType {
  OPEN_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  MORAL_DILEMMA
  LOGIC
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TargetType {
  LESSON
  SHORT_LESSON
  STORY
  DEBATE
  ARGUMENT
  TOPIC
  MINDMAP_NODE
  REFLECTION
  AI_CHAT
  SCENARIO
  QUIZ
  MINI_GAME
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

enum ModerationActionType {
  HIDE
  DELETE
  WARN
  BAN
  RESTORE
  NO_ACTION
}

// ── T-D01: Story Mode Engine ─────────────────────────────────

enum AnalysisTabType {
  ETHICAL
  PHILOSOPHICAL
  POLITICAL_ECONOMIC
  HISTORICAL
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  fullName        String    @map("full_name") @db.VarChar(150)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url")
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  streakCount     Int       @default(0) @map("streak_count")
  lastActiveAt    DateTime? @map("last_active_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions              UserSession[]
  refreshTokens         RefreshToken[]
  progress              UserProgress[]
  activityLogs          ActivityLog[]
  userBadges            UserBadge[]
  bookmarks             Bookmark[]
  notifications         Notification[]
  storySessions         StorySession[]
  storyDecisions        StoryDecision[]
  lessonAnswers         LessonAnswer[]
  shortLessonResponses  ShortLessonResponse[]
  shortLessonComments   ShortLessonComment[]
  aiChatSessions        AiChatSession[]
  scenarioResponses     ScenarioResponse[]
  debateArguments       DebateArgument[]
  debateComments        DebateComment[]
  debateVotes           DebateVote[]
  reflectionEntries     ReflectionEntry[]
  quizAttempts          QuizAttempt[]
  miniGameAttempts      MiniGameAttempt[]
  reports               Report[]             @relation("ReporterReports")
  moderationActions     ModerationAction[]   @relation("ModeratorActions")

  @@map("users")
}

model UserSession {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  deviceName   String?       @map("device_name") @db.VarChar(150)
  ipAddress    String?       @map("ip_address") @db.VarChar(80)
  userAgent    String?       @map("user_agent")
  status       SessionStatus @default(ACTIVE)
  lastActiveAt DateTime?     @map("last_active_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  revokedAt    DateTime?     @map("revoked_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, status])
  @@map("user_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([sessionId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Topic {
  id          String     @id @default(uuid()) @db.Uuid
  title       String     @db.VarChar(200)
  description String?
  category    String?    @db.VarChar(100)
  difficulty  Difficulty @default(EASY)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  lessons           Lesson[]
  shortLessons      ShortLesson[]
  storyScenarios    StoryScenario[]
  realLifeScenarios RealLifeScenario[]
  debates           Debate[]
  criticalQuestions CriticalQuestion[]
  mindmapNodes      MindmapNode[]
  reflections       ReflectionEntry[]

  @@index([category])
  @@index([createdAt])
  @@map("topics")
}

model Lesson {
  id              String        @id @default(uuid()) @db.Uuid
  topicId         String        @map("topic_id") @db.Uuid
  title           String        @db.VarChar(200)
  content         String
  realLifeExample String?       @map("real_life_example")
  conflict        String?
  estimatedMinutes Int?         @map("estimated_minutes")
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  topic      Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions  LessonQuestion[]
  progress   UserProgress[]
  quizzes    Quiz[]

  @@index([topicId, status])
  @@map("lessons")
}

model LessonQuestion {
  id           String       @id @default(uuid()) @db.Uuid
  lessonId     String       @map("lesson_id") @db.Uuid
  question     String
  questionType QuestionType @default(OPEN_TEXT) @map("question_type")
  createdAt    DateTime     @default(now()) @map("created_at")

  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers LessonAnswer[]

  @@index([lessonId])
  @@map("lesson_questions")
}

model LessonAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  answerText String   @map("answer_text")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@map("lesson_answers")
}

model ShortLesson {
  id               String   @id @default(uuid()) @db.Uuid
  topicId          String   @map("topic_id") @db.Uuid
  title            String   @db.VarChar(200)
  hook             String
  insight          String
  conflict         String
  stanceA          String   @map("stance_a")
  stanceB          String   @map("stance_b")
  estimatedSeconds Int?     @map("estimated_seconds")
  createdAt        DateTime @default(now()) @map("created_at")

  topic     Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  responses ShortLessonResponse[]
  comments  ShortLessonComment[]

  @@index([topicId])
  @@map("short_lessons")
}

model ShortLessonResponse {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  shortLessonId String   @map("short_lesson_id") @db.Uuid
  selectedStance String  @map("selected_stance") @db.VarChar(50)
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shortLesson ShortLesson @relation(fields: [shortLessonId], references: [id], onDelete: Cascade)

  @@unique([userId, shortLessonId])
  @@index([shortLessonId])
  @@map("short_lesson_responses")
}

model ShortLessonComment {
  id            String   @id @default(uuid()) @db.Uuid
  shortLessonId String   @map("short_lesson_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  commentText   String   @map("comment_text")
  createdAt     DateTime @default(now()) @map("created_at")

  shortLesson ShortLesson @relation(fields: [shortLessonId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shortLessonId, createdAt])
  @@index([userId])
  @@map("short_lesson_comments")
}

model StoryScenario {
  id                String     @id @default(uuid()) @db.Uuid
  topicId           String     @map("topic_id") @db.Uuid
  title             String     @db.VarChar(200)
  description       String
  characterRole     String?    @map("character_role")
  historicalContext String?    @map("historical_context")
  difficulty        Difficulty @default(EASY)
  createdAt         DateTime   @default(now()) @map("created_at")

  topic        Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  choices      StoryChoice[]
  sessions     StorySession[]
  learnCards   StoryLearnCard[]

  @@index([topicId])
  @@index([createdAt])
  @@map("story_scenarios")
}

model StoryChoice {
  id              String   @id @default(uuid()) @db.Uuid
  storyId         String   @map("story_id") @db.Uuid
  choiceText      String   @map("choice_text")
  reasoningPrompt String?  @map("reasoning_prompt")

  story        StoryScenario      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  consequences StoryConsequence[]
  decisions    StoryDecision[]

  @@index([storyId])
  @@map("story_choices")
}

model StoryConsequence {
  id                        String  @id @default(uuid()) @db.Uuid
  choiceId                  String  @map("choice_id") @db.Uuid
  resultText                String  @map("result_text")
  ethicalAnalysis           String? @map("ethical_analysis")
  philosophicalAnalysis     String? @map("philosophical_analysis")
  politicalEconomicAnalysis String? @map("political_economic_analysis")
  historicalImpact          String? @map("historical_impact")

  choice       StoryChoice    @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  analysisTabs AnalysisTab[]

  @@index([choiceId])
  @@map("story_consequences")
}

model StorySession {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  storyId     String             @map("story_id") @db.Uuid
  status      StorySessionStatus @default(IN_PROGRESS)
  startedAt   DateTime           @default(now()) @map("started_at")
  completedAt DateTime?          @map("completed_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     StoryScenario   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  decisions StoryDecision[]

  @@index([userId, storyId, status])
  @@index([storyId])
  @@map("story_sessions")
}

model StoryDecision {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  choiceId   String   @map("choice_id") @db.Uuid
  userReason String?  @map("user_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  session StorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice  StoryChoice  @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId])
  @@map("story_decisions")
}

model AiCharacter {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(150)
  type              String   @db.VarChar(100)
  bio               String?
  worldview         String?
  promptInstruction String   @map("prompt_instruction")
  createdAt         DateTime @default(now()) @map("created_at")

  chatSessions AiChatSession[]

  @@map("ai_characters")
}

model AiChatSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  characterId String   @map("character_id") @db.Uuid
  title       String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  character AiCharacter     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]

  @@index([userId, createdAt])
  @@index([characterId])
  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id        String     @id @default(uuid()) @db.Uuid
  sessionId String     @map("session_id") @db.Uuid
  senderType SenderType @map("sender_type")
  message   String
  metadata  Json?
  createdAt DateTime   @default(now()) @map("created_at")

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("ai_chat_messages")
}

model RealLifeScenario {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  title     String   @db.VarChar(200)
  situation String
  context   String?
  createdAt DateTime @default(now()) @map("created_at")

  topic     Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  responses ScenarioResponse[]
  analyses  ScenarioAnalysis[]

  @@index([topicId])
  @@map("real_life_scenarios")
}

model ScenarioResponse {
  id               String   @id @default(uuid()) @db.Uuid
  scenarioId        String   @map("scenario_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  selectedDecision  String   @map("selected_decision")
  reason            String?
  createdAt         DateTime @default(now()) @map("created_at")

  scenario RealLifeScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([userId])
  @@map("scenario_responses")
}

model ScenarioAnalysis {
  id              String @id @default(uuid()) @db.Uuid
  scenarioId      String @map("scenario_id") @db.Uuid
  perspectiveType String @map("perspective_type") @db.VarChar(100)
  analysisContent String @map("analysis_content")

  scenario RealLifeScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@map("scenario_analyses")
}

model Debate {
  id          String       @id @default(uuid()) @db.Uuid
  topicId     String       @map("topic_id") @db.Uuid
  title       String       @db.VarChar(200)
  description String?
  status      DebateStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @map("created_at")

  topic     Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  arguments DebateArgument[]

  @@index([topicId, status])
  @@map("debates")
}

model DebateArgument {
  id           String       @id @default(uuid()) @db.Uuid
  debateId     String       @map("debate_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  stance       DebateStance
  argumentText String       @map("argument_text")
  voteCount    Int          @default(0) @map("vote_count")
  createdAt    DateTime     @default(now()) @map("created_at")

  debate   Debate          @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments DebateComment[]
  votes    DebateVote[]

  @@index([debateId, voteCount])
  @@index([userId])
  @@map("debate_arguments")
}

model DebateComment {
  id           String   @id @default(uuid()) @db.Uuid
  argumentId   String   @map("argument_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  commentText  String   @map("comment_text")
  createdAt    DateTime @default(now()) @map("created_at")

  argument DebateArgument @relation(fields: [argumentId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([argumentId, createdAt])
  @@index([userId])
  @@map("debate_comments")
}

model DebateVote {
  id         String    @id @default(uuid()) @db.Uuid
  argumentId String    @map("argument_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  value      VoteValue
  createdAt  DateTime  @default(now()) @map("created_at")

  argument DebateArgument @relation(fields: [argumentId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([argumentId, userId])
  @@index([userId])
  @@map("debate_votes")
}

model CriticalQuestion {
  id           String       @id @default(uuid()) @db.Uuid
  topicId      String       @map("topic_id") @db.Uuid
  question     String
  questionType QuestionType @map("question_type")
  createdAt    DateTime     @default(now()) @map("created_at")

  topic       Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reflections ReflectionEntry[]

  @@index([topicId])
  @@map("critical_questions")
}

model ReflectionEntry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  topicId    String?  @map("topic_id") @db.Uuid
  questionId String?  @map("question_id") @db.Uuid
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic    Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  question CriticalQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([topicId])
  @@map("reflection_entries")
}

model Quiz {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  title    String @db.VarChar(200)
  quizType String @map("quiz_type") @db.VarChar(100)

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id           String       @id @default(uuid()) @db.Uuid
  quizId       String       @map("quiz_id") @db.Uuid
  question     String
  questionType QuestionType @map("question_type")

  quiz           Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options        QuizOption[]
  attemptAnswers QuizAttemptAnswer[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  optionText String  @map("option_text")
  isCorrect  Boolean @default(false) @map("is_correct")

  question       QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers QuizAttemptAnswer[]

  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  quizId      String    @map("quiz_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  score       Int       @default(0)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  quiz    Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String  @id @default(uuid()) @db.Uuid
  attemptId         String  @map("attempt_id") @db.Uuid
  questionId        String  @map("question_id") @db.Uuid
  selectedOptionId  String? @map("selected_option_id") @db.Uuid
  textAnswer        String? @map("text_answer")
  isCorrect         Boolean @default(false) @map("is_correct")

  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuizOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_attempt_answers")
}

model MiniGame {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  gameType    String   @map("game_type") @db.VarChar(100)
  description String?
  config      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  attempts MiniGameAttempt[]

  @@map("mini_games")
}

model MiniGameAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  miniGameId  String    @map("mini_game_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  score       Int       @default(0)
  resultData  Json?     @map("result_data")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  miniGame MiniGame @relation(fields: [miniGameId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([miniGameId])
  @@index([userId])
  @@map("mini_game_attempts")
}

model MindmapNode {
  id          String  @id @default(uuid()) @db.Uuid
  topicId     String  @map("topic_id") @db.Uuid
  title       String  @db.VarChar(200)
  description String?
  nodeType    String  @map("node_type") @db.VarChar(100)

  topic         Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceEdges   MindmapEdge[] @relation("SourceNode")
  targetEdges   MindmapEdge[] @relation("TargetNode")

  @@index([topicId])
  @@map("mindmap_nodes")
}

model MindmapEdge {
  id           String @id @default(uuid()) @db.Uuid
  sourceNodeId String @map("source_node_id") @db.Uuid
  targetNodeId String @map("target_node_id") @db.Uuid
  relationType String @map("relation_type") @db.VarChar(100)

  sourceNode MindmapNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode MindmapNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("mindmap_edges")
}

model UserProgress {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  lessonId        String         @map("lesson_id") @db.Uuid
  status          ProgressStatus @default(NOT_STARTED)
  progressPercent Int            @default(0) @map("progress_percent")
  completedAt     DateTime?      @map("completed_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([userId, status])
  @@map("user_progress")
}

model Badge {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @db.VarChar(150)
  description   String?
  iconUrl       String? @map("icon_url")
  conditionType String  @unique @map("condition_type") @db.VarChar(100)

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  badgeId  String   @map("badge_id") @db.Uuid
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model Bookmark {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  targetType TargetType @map("target_type")
  targetId   String     @map("target_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@index([userId, targetType, createdAt])
  @@map("bookmarks")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(100)
  content   String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  activityType String     @map("activity_type") @db.VarChar(100)
  targetType   TargetType @map("target_type")
  targetId     String?    @map("target_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([activityType])
  @@map("activity_logs")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  targetType TargetType   @map("target_type")
  targetId   String       @map("target_id") @db.Uuid
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")

  reporter User               @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  actions  ModerationAction[]

  @@index([reporterId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, targetType, createdAt])
  @@index([targetType, targetId])
  @@index([targetType, createdAt])
  @@map("reports")
}

model ModerationAction {
  id          String               @id @default(uuid()) @db.Uuid
  reportId    String               @map("report_id") @db.Uuid
  moderatorId String               @map("moderator_id") @db.Uuid
  actionType  ModerationActionType @map("action_type")
  note        String?
  createdAt   DateTime             @default(now()) @map("created_at")

  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  moderator User   @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([moderatorId])
  @@map("moderation_actions")
}

// ── T-D01: New Story Mode models ─────────────────────────────

model PhilosophyTag {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  storyLearnCardTags StoryLearnCardTag[]

  @@index([name])
  @@map("philosophy_tags")
}

model StoryLearnCard {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  title     String   @db.VarChar(200)
  body      String
  sourceRef String?  @map("source_ref") @db.VarChar(200)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  story StoryScenario      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tags  StoryLearnCardTag[]

  @@index([storyId, order])
  @@map("story_learn_cards")
}

model StoryLearnCardTag {
  cardId String @map("card_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  card StoryLearnCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  PhilosophyTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@map("story_learn_card_tags")
}

model AnalysisTab {
  id            String          @id @default(uuid()) @db.Uuid
  consequenceId String          @map("consequence_id") @db.Uuid
  tabType       AnalysisTabType @map("tab_type")
  content       String
  order         Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at")

  consequence StoryConsequence @relation(fields: [consequenceId], references: [id], onDelete: Cascade)

  @@unique([consequenceId, tabType])
  @@index([consequenceId, order])
  @@map("analysis_tabs")
}
