{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@libs/shared": ["../libs/shared/dist/index.d.ts"],
      "@libs/shared/*": ["../libs/shared/dist/*"],
      "@philo-mind/shared": ["../libs/shared/dist/index.d.ts"],
      "@philo-mind/shared/*": ["../libs/shared/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
