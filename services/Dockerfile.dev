# syntax=docker/dockerfile:1
# ─── PhiloMind API · Dev Dockerfile ──────────────────────────
# Hot-reload via tsx watch — NOT for production
# ──────────────────────────────────────────────────────────────

FROM node:22-alpine AS dev

WORKDIR /app

# Install dependencies first (layer cache)
COPY package.json ./
RUN npm install

# Copy Prisma schema & generate client
COPY prisma.config.ts ./
COPY src/prisma/schema.prisma ./src/prisma/schema.prisma
RUN npx prisma generate

# Source is bind-mounted at runtime for hot-reload
# COPY src/ ./src/  ← NOT needed; volume mount handles this

EXPOSE 3001

# Run migrations explicitly when needed; container startup must not mutate the database.
CMD ["npm", "run", "dev"]
