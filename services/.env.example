# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ────────────────────────────────────────────────
# For Docker Compose (local):
DATABASE_URL=postgresql://philo:philo_secret@localhost:5432/philo_mind?schema=public
# For Prisma Accelerate (cloud):
# DATABASE_URL=postgres://token:sk_xxx@pooled.db.prisma.io:5432/postgres?sslmode=require

# ── Redis (optional — auto-configured in Docker Compose) ────
# REDIS_URL=redis://localhost:6379

# ── JWT / Auth (REQUIRED) ──────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-char-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI / Gemini (optional — needed for Track E) ────────────
# GEMINI_API_KEY=

# ── Storage / Cloudinary (optional — needed for avatar/image upload) ──
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Email / SMTP (optional — needed for email verification) ─
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@philomind.app

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
