# ── Docker Compose environment ───────────────────────────────
# Copy to .env and adjust values as needed
# Usage: cp .env.example .env && docker compose up -d
# ──────────────────────────────────────────────────────────────

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=philo
POSTGRES_PASSWORD=philo_secret
POSTGRES_DB=philo_mind
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ── API ──────────────────────────────────────────────────────
API_PORT=3001
JWT_SECRET=dev_jwt_secret_change_me_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOG_LEVEL=debug